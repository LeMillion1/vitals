# Vitals identity-provider control plane. Copy to `.env.idp`, chmod 600, and
# never mount it into `vitals_app`. Pass both env files only to explicit IDP
# Compose commands: `docker compose --env-file .env --env-file .env.idp ...`.

# Exactly 32 characters; escrow outside the VPS before first provider start.
VITALS_IDP_MASTERKEY=
VITALS_IDP_DB_PASSWORD=
VITALS_IDP_ADMIN_PASSWORD=
VITALS_IDP_DOMAIN=localhost
VITALS_IDP_PORT=8080
VITALS_IDP_SECURE=false

# Independent local recovery rhythm.
VITALS_IDP_BACKUP_RETENTION_DAYS=7

# Independent encrypted repository. These are paths to owner-only Compose
# secret files, never the secret values themselves. The IDP snapshot excludes
# both `.env` and `.env.idp`; escrow the master key separately.
# VITALS_IDP_RESTIC_REPOSITORY_FILE=.secrets/idp_restic_repository
# VITALS_IDP_RESTIC_PASSWORD_FILE=.secrets/idp_restic_password
# VITALS_IDP_RESTIC_S3_ACCESS_KEY_FILE=.secrets/idp_restic_s3_access_key
# VITALS_IDP_RESTIC_S3_SECRET_KEY_FILE=.secrets/idp_restic_s3_secret_key
# VITALS_IDP_OFFSITE_HOSTNAME=vitals-production-identity
# VITALS_IDP_OFFSITE_INTERVAL_SECONDS=900
