# Vitals identity-provider control plane. Copy to `.env.idp`, chmod 600, and
# never mount it into `vitals_app`. Pass both env files only to explicit IDP
# Compose commands: `docker compose --env-file .env --env-file .env.idp ...`.

# These paths point to owner-only, one-line files below `.secrets/`. Generate
# independent URL-safe passwords with `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`. The master-key file must contain exactly
# 32 bytes with no trailing newline and must also be escrowed outside the VPS.
VITALS_IDP_MASTERKEY_FILE=.secrets/idp_masterkey
VITALS_IDP_DB_ADMIN_PASSWORD_FILE=.secrets/idp_db_admin_password
VITALS_IDP_DB_SERVICE_PASSWORD_FILE=.secrets/idp_db_service_password
VITALS_IDP_DB_BACKUP_PASSWORD_FILE=.secrets/idp_db_backup_password
VITALS_IDP_ADMIN_PASSWORD_FILE=.secrets/idp_admin_password

# Public issuer and the loopback-only origin are separate notions. Production
# uses an HTTPS hostname on 443 and publishes only the local gateway port.
VITALS_IDP_DOMAIN=idp.example.com
VITALS_IDP_PUBLIC_SCHEME=https
VITALS_IDP_EXTERNAL_PORT=443
# Canonical HTTP Host / OIDC issuer authority. Omit the default :443.
VITALS_IDP_PUBLIC_AUTHORITY=idp.example.com
VITALS_IDP_ORIGIN_PORT=8080
VITALS_IDP_SECURE=true

# The first human is forced to change this file-backed password at first login.
VITALS_IDP_ADMIN_USERNAME=zitadel-admin
VITALS_IDP_ADMIN_EMAIL=operator@example.com

# Login V2 has its own narrowly scoped PAT. Use an explicit finite expiry and
# rotate it with an independently escrowed IAM_OWNER break-glass credential.
VITALS_IDP_LOGIN_PAT_EXPIRATION=2027-08-26T00:00:00Z

# Independent local recovery rhythm.
VITALS_IDP_BACKUP_RETENTION_DAYS=7

# Independent encrypted repository. These are paths to owner-only Compose
# secret files, never the secret values themselves. The IDP snapshot excludes
# both `.env` and `.env.idp`; escrow the master key separately.
# VITALS_IDP_RESTIC_REPOSITORY_FILE=.secrets/idp_restic_repository
# VITALS_IDP_RESTIC_PASSWORD_FILE=.secrets/idp_restic_password
# VITALS_IDP_RESTIC_S3_ACCESS_KEY_FILE=.secrets/idp_restic_s3_access_key
# VITALS_IDP_RESTIC_S3_SECRET_KEY_FILE=.secrets/idp_restic_s3_secret_key
# VITALS_IDP_OFFSITE_HOSTNAME=vitals-production-identity
# VITALS_IDP_OFFSITE_INTERVAL_SECONDS=900
