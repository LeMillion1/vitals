{
	admin off

	# Preserve the originating address when this normal DNS route is proxied by
	# Cloudflare, but never trust a client-supplied forwarding header from any
	# other peer. Source: https://www.cloudflare.com/ips/ (2026-08-27).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$VITALS_IDP_DOMAIN} {
	@root path /
	redir @root /ui/v2/login/ 302

	@login path /ui/v2/login /ui/v2/login/*
	reverse_proxy @login http://vitals_idp_login:3000

	reverse_proxy h2c://vitals_idp:8080 {
		# ZITADEL documents a Caddy/gRPC-gateway hang when this request
		# header reaches the h2c upstream on an error response.
		header_up -TE
		header_up Host {$VITALS_IDP_PUBLIC_AUTHORITY}
	}
}

# Container-local readiness only. The production evidence still has to prove
# the public certificate, issuer, Login V2 and gRPC over auth.<domain>:443.
:8081 {
	respond /debug/ready 200
}
