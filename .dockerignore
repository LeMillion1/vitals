config.local.*
*.pem
*.key
*.crt
*.cert
private_key.txt
oauth_tokens*.json
garmin_session/
.garmin_session/
*garmin*session*
web/static/uploads/
*.db
*.sqlite
*.sqlite3
backups/
.coverage
htmlcov/

